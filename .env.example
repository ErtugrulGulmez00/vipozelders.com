# Geliştirme ortamı ayarları (bu dosya git'e eklenmez)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vipozelders?schema=public"
APP_URL="http://localhost:3000"
APP_SECRET="en-az-32-karakterlik-rastgele-bir-deger"

# Ödeme: mock (sahte test ödemesi) | paytr | iyzico
PAYMENT_PROVIDER="mock"
# PayTR mağaza paneli → Destek & Kurulum → Entegrasyon Bilgileri
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# 1 = test modu (gerçek para çekilmez), canlıda 0
PAYTR_TEST_MODE="1"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Görüntülü ders (LiveKit) - boşsa sanal sınıf "yapılandırılmadı" uyarısı gösterir
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# E-posta: SMTP boşsa e-postalar sadece veritabanına yazılır ve admin panelinden okunur
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Pi Kampüs <bildirim@example.com>"

# --- İsteğe bağlı ---
# iyzico pazaryeri modu: öğretmen alt üye işyeri olur, hakediş iyzico tarafından otomatik ödenir
IYZICO_MARKETPLACE="false"
# iyzico iade isteklerinde bildirilen sunucu IP'si
SERVER_PUBLIC_IP=""
# Yüklenen dosyaların klasörü (varsayılan: storage/uploads)
STORAGE_DIR=""
# Mobil uygulama push bildirimleri: Firebase servis hesabı JSON dosyasının yolu (boşsa push gönderilmez)
FCM_SERVICE_ACCOUNT_FILE=""
# Site bağlantılarının mobil uygulamada açılması (boşsa /.well-known adresleri 404 döner, bağlantılar tarayıcıda açılır).
# Android: imza sertifikalarının SHA-256 parmak izleri, virgülle (Play Console > Uygulama imzalama). iOS: <TeamID>.com.pikampus.app
ANDROID_APP_SHA256=""
IOS_APP_ID=""
# Kurum paneli SMS'leri (Netgsm). Boşsa SMS'ler yalnızca kurumun mesaj geçmişine kaydedilir.
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_HEADER=""
# WhatsApp Business Cloud API (Meta). Boşsa WhatsApp bildirimi gönderilmez.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Server Action'lara izin verilen ek adresler (virgülle). APP_URL'deki adres zaten kabul edilir.
SERVER_ACTIONS_ALLOWED_ORIGINS=""
# Arka plan görevlerini ayrı süreçte (npm run worker) çalıştıracaksanız true yapın
DISABLE_INTERNAL_SCHEDULER="false"
# Seed: canlıda demo veri yüklememek için false; yönetici hesabı bilgileri
SEED_DEMO=""
ADMIN_USERNAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
