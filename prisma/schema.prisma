// Pi Kampüs veri modeli.
// Para alanları kuruş cinsinden tam sayıdır (1250 TL = 125000).
// Zaman alanları UTC saklanır; gösterimde Europe/Istanbul kullanılır.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Kullanıcılar ve oturumlar
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TEACHER
  STUDENT
  // Kurum paneli personeli (etüt merkezi / dershane)
  CENTER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AccountType {
  PARENT
  STUDENT
}

enum Gender {
  FEMALE
  MALE
  UNSPECIFIED
}

model User {
  id                 String     @id @default(cuid())
  role               Role
  status             UserStatus @default(ACTIVE)
  email              String?    @unique
  username           String?    @unique
  passwordHash       String
  mustChangePassword Boolean    @default(false)
  firstName          String
  lastName           String
  phone              String?
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  // İki adımlı doğrulama (TOTP). Gizli anahtar AES-256-GCM ile şifreli; totpEnabledAt boşsa kurulum yarım.
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  // Aynı kodun ikinci kez kullanılmaması için son kabul edilen 30 sn'lik adım.
  totpLastStep       Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions          Session[]
  tokens            UserToken[]
  teacherProfile    TeacherProfile?
  studentProfile    StudentProfile?
  notifications     Notification[]
  bookingsAsStudent Booking[]          @relation("StudentBookings")
  reviews           Review[]
  favorites         Favorite[]
  auditLogs         AuditLog[]
  bookingEvents     BookingEvent[]
  attendance        LessonAttendance[]
  emails            EmailMessage[]
  payoutsCreated    Payout[]           @relation("PayoutCreatedBy")
  devices           Device[]
  centerMemberships CenterMember[]
  guardianLinks     CenterGuardian[]   @relation("GuardianAccounts")
}

// Mobil uygulama push bildirim kayıtları (Firebase Cloud Messaging).
model Device {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Session {
  // Çerezdeki rastgele anahtarın SHA-256 özeti; anahtarın kendisi saklanmaz.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_LOGIN
  // Mobil uygulamanın WebView'da (ödeme, sanal sınıf) web oturumu açması için tek kullanımlık anahtar.
  MOBILE_WEB_LOGIN
}

model UserToken {
  // Bağlantıdaki anahtarın SHA-256 özeti.
  id        String        @id
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ipAddress  String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
}

model StudentProfile {
  userId           String      @id
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType      AccountType @default(PARENT)
  cityId           Int?
  city             City?       @relation(fields: [cityId], references: [id])
  kvkkConsentAt    DateTime
  marketingConsent Boolean     @default(false)
  learners         Learner[]
}

// Dersin kimin için alındığı (veli hesabındaki çocuklar ya da öğrencinin kendisi).
model Learner {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  name      String
  gradeName String?
  createdAt DateTime       @default(now())
  bookings  Booking[]

  @@unique([studentId, name])
}

// ---------------------------------------------------------------------------
// Katalog: kademe, sınıf, ders, hizmet türü, il/ilçe
// ---------------------------------------------------------------------------

enum LevelGroup {
  SCHOOL
  EXAM
  OTHER
}

model Level {
  id        Int               @id @default(autoincrement())
  name      String
  slug      String            @unique
  group     LevelGroup        @default(SCHOOL)
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  grades    Grade[]
  subjects  LevelSubject[]
  offerings TeacherOffering[]
  bookings  Booking[]
}

model Grade {
  id        Int    @id @default(autoincrement())
  levelId   Int
  level     Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)

  @@unique([levelId, name])
}

model Subject {
  id        Int               @id @default(autoincrement())
  name      String
  slug      String            @unique
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  levels    LevelSubject[]
  offerings TeacherOffering[]
  bookings  Booking[]
}

model LevelSubject {
  levelId   Int
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([levelId, subjectId])
}

model ServiceType {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  offerings   TeacherOffering[]
  bookings    Booking[]
}

model City {
  id                 Int                  @id
  name               String
  slug               String               @unique
  districts          District[]
  teachers           TeacherProfile[]
  studentProfiles    StudentProfile[]
  bookings           Booking[]
  applications       TeacherApplication[]
  centers            Center[]
  centerApplications CenterApplication[]
}

model District {
  id              Int                      @id @default(autoincrement())
  cityId          Int
  city            City                     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  teachers        TeacherProfile[]
  serviceTeachers TeacherServiceDistrict[]
  bookings        Booking[]
  centers         Center[]

  @@unique([cityId, slug])
}

// ---------------------------------------------------------------------------
// Öğretmen
// ---------------------------------------------------------------------------

enum TeacherStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model TeacherProfile {
  userId                  String             @id
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                    String             @unique
  headline                String?
  bio                     String?
  photoKey                String?
  videoUrl                String?
  education               String?
  experienceYears         Int                @default(0)
  gender                  Gender             @default(UNSPECIFIED)
  cityId                  Int?
  city                    City?              @relation(fields: [cityId], references: [id])
  districtId              Int?
  district                District?          @relation(fields: [districtId], references: [id])
  offersOnline            Boolean            @default(true)
  offersInPerson          Boolean            @default(false)
  inPersonAtStudentHome   Boolean            @default(true)
  inPersonAtTeacherPlace  Boolean            @default(false)
  status                  TeacherStatus      @default(DRAFT)
  verificationStatus      VerificationStatus @default(UNVERIFIED)
  isFeatured              Boolean            @default(false)
  // Öğretmene özel komisyon (baz puan: 1500 = %15). Boşsa site ayarı geçerli.
  commissionRateBps       Int?
  bufferMinutes           Int                @default(0)
  // Kadrolu (devlet okulu) öğretmen olmadığına dair beyanın tarihi.
  statusDeclarationAt     DateTime?
  // Hakediş bilgileri
  payoutLegalName         String?
  payoutIban              String?
  payoutIdentityNumberEnc String?
  subMerchantKey          String?
  // Özet istatistikler (yorum ve ders işlemlerinde güncellenir)
  ratingAvg               Float              @default(0)
  ratingCount             Int                @default(0)
  completedLessons        Int                @default(0)
  avgResponseMinutes      Int?
  responseCount           Int                @default(0)
  cancellationCount       Int                @default(0)
  searchText              String             @default("")
  publishedAt             DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  serviceDistricts       TeacherServiceDistrict[]
  offerings              TeacherOffering[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]
  reviews                Review[]
  favorites              Favorite[]
  documents              TeacherDocument[]
  ledgerEntries          LedgerEntry[]
  payouts                Payout[]

  @@index([status])
}

model TeacherServiceDistrict {
  teacherId  String
  teacher    TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  districtId Int
  district   District       @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@id([teacherId, districtId])
}

model TeacherOffering {
  id            String         @id @default(cuid())
  teacherId     String
  teacher       TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  serviceTypeId Int
  serviceType   ServiceType    @relation(fields: [serviceTypeId], references: [id])
  levelId       Int
  level         Level          @relation(fields: [levelId], references: [id])
  subjectId     Int
  subject       Subject        @relation(fields: [subjectId], references: [id])
  // Öğrencinin ödeyeceği 60 dakikalık ücret (KDV dahil, kuruş).
  hourlyPrice   Int
  durations     Int[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookings      Booking[]

  @@unique([teacherId, serviceTypeId, levelId, subjectId])
  @@index([levelId, subjectId])
}

enum AvailabilityExceptionType {
  BLOCKED
  EXTRA
}

model AvailabilityRule {
  id          String         @id @default(cuid())
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  // ISO hafta günü: 1 = Pazartesi ... 7 = Pazar
  weekday     Int
  startMinute Int
  endMinute   Int

  @@index([teacherId])
}

model AvailabilityException {
  id          String                    @id @default(cuid())
  teacherId   String
  teacher     TeacherProfile            @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  date        DateTime                  @db.Date
  type        AvailabilityExceptionType
  // İkisi de boşsa bütün gün
  startMinute Int?
  endMinute   Int?
  note        String?
  createdAt   DateTime                  @default(now())

  @@index([teacherId, date])
}

enum DocumentType {
  DIPLOMA
  IDENTITY
  CRIMINAL_RECORD
  CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  NEW
  APPROVED
  REJECTED
}

// Sitedeki "Öğretmen olarak katılın" formundan gelen başvurular; yönetici tek tıkla hesap açar.
model TeacherApplication {
  id              String            @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String
  cityId          Int?
  city            City?             @relation(fields: [cityId], references: [id])
  subjects        String
  experienceYears Int               @default(0)
  education       String?
  message         String?
  offersOnline    Boolean           @default(true)
  offersInPerson  Boolean           @default(false)
  status          ApplicationStatus @default(NEW)
  note            String?
  teacherId       String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())

  @@index([status, createdAt])
  @@index([email])
}

model TeacherDocument {
  id         String         @id @default(cuid())
  teacherId  String
  teacher    TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  type       DocumentType
  fileKey    String
  fileName   String
  status     DocumentStatus @default(PENDING)
  note       String?
  createdAt  DateTime       @default(now())
  reviewedAt DateTime?
}

// ---------------------------------------------------------------------------
// Randevu, ödeme ve hakediş
// ---------------------------------------------------------------------------

enum LessonMode {
  ONLINE
  IN_PERSON
}

enum InPersonPlace {
  STUDENT_HOME
  TEACHER_PLACE
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  PENDING_APPROVAL
  CONFIRMED
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED_BY_STUDENT
  CANCELLED_BY_TEACHER
  CANCELLED_BY_ADMIN
  NO_SHOW_STUDENT
  NO_SHOW_TEACHER
  DISPUTED
}

model Booking {
  id                 String           @id @default(cuid())
  code               String           @unique
  studentId          String
  student            User             @relation("StudentBookings", fields: [studentId], references: [id])
  teacherId          String
  teacher            TeacherProfile   @relation(fields: [teacherId], references: [userId])
  offeringId         String?
  offering           TeacherOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  learnerId          String?
  learner            Learner?         @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  serviceTypeId      Int
  serviceType        ServiceType      @relation(fields: [serviceTypeId], references: [id])
  levelId            Int
  level              Level            @relation(fields: [levelId], references: [id])
  subjectId          Int
  subject            Subject          @relation(fields: [subjectId], references: [id])
  // Randevu anındaki adların kopyası (katalog sonradan değişse de kayıt bozulmaz)
  serviceName        String
  levelName          String
  subjectName        String
  learnerName        String
  learnerGrade       String?
  mode               LessonMode
  inPersonPlace      InPersonPlace?
  cityId             Int?
  city               City?            @relation(fields: [cityId], references: [id])
  districtId         Int?
  district           District?        @relation(fields: [districtId], references: [id])
  address            String?
  studentNote        String?
  startAt            DateTime
  endAt              DateTime
  // Dersin bitişi + öğretmenin tampon süresi; çakışma kontrolü bu aralıkla yapılır.
  blockEndAt         DateTime
  durationMinutes    Int
  price              Int
  commissionRateBps  Int
  commissionAmount   Int
  teacherAmount      Int
  refundedAmount     Int              @default(0)
  status             BookingStatus    @default(PENDING_PAYMENT)
  holdExpiresAt      DateTime?
  paidAt             DateTime?
  approvalDeadline   DateTime?
  confirmedAt        DateTime?
  respondedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  rejectionReason    String?
  disputeReason      String?
  disputedAt         DateTime?
  reminder24hSentAt  DateTime?
  reminder1hSentAt   DateTime?
  earningsReleaseAt  DateTime?
  earningsReleasedAt DateTime?
  videoRoomName      String?          @unique
  // Yönetici tarafından ödemesiz açılan deneme dersi (görüntülü görüşme testi); yorum, puan ve ciroya sayılmaz.
  isTest             Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  events        BookingEvent[]
  payments      Payment[]
  attendance    LessonAttendance[]
  review        Review?
  ledgerEntries LedgerEntry[]

  @@index([teacherId, startAt])
  @@index([studentId, startAt])
  @@index([status])
}

model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime       @default(now())

  @@index([bookingId])
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider          String
  providerToken     String?       @unique
  providerPaymentId String?
  providerItemId    String?
  amount            Int
  refundedAmount    Int           @default(0)
  status            PaymentStatus @default(INITIATED)
  failureReason     String?
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  refunds           Refund[]

  @@index([bookingId])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// İade önce PENDING kaydedilir, sonra sağlayıcıya iletilir; başarısız olursa yeniden denenir.
model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount           Int
  reason           String
  status           RefundStatus @default(PENDING)
  attempts         Int          @default(0)
  providerRefundId String?
  error            String?
  createdAt        DateTime     @default(now())
  processedAt      DateTime?

  @@index([status])
}

enum LedgerBucket {
  PENDING
  AVAILABLE
  PAID
}

// Öğretmen hakediş defteri. Bir kovanın bakiyesi = o kovadaki tutarların toplamı.
model LedgerEntry {
  id          String         @id @default(cuid())
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  bookingId   String?
  booking     Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payoutId    String?
  payout      Payout?        @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  bucket      LedgerBucket
  amount      Int
  description String
  createdAt   DateTime       @default(now())

  @@index([teacherId, bucket])
}

enum PayoutMethod {
  MANUAL_TRANSFER
  PAYMENT_PROVIDER
}

model Payout {
  id          String         @id @default(cuid())
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  amount      Int
  method      PayoutMethod
  reference   String?
  createdById String?
  createdBy   User?          @relation("PayoutCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  entries     LedgerEntry[]
}

model LessonAttendance {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime
  leftAt    DateTime?

  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Yorumlar, favoriler, bildirimler
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model Review {
  id               String         @id @default(cuid())
  bookingId        String         @unique
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  studentId        String
  student          User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String?
  teacherReply     String?
  teacherRepliedAt DateTime?
  status           ReviewStatus   @default(PUBLISHED)
  hiddenReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([teacherId, studentId])
  @@index([teacherId, status])
}

model Favorite {
  studentId String
  student   User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([studentId, teacherId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  // Mobil cihazlara push gönderildiği an (gönderim kuyruğu).
  pushedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailMessage {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  to        String
  subject   String
  text      String
  html      String
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  error     String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Site yönetimi
// ---------------------------------------------------------------------------

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Page {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  content      String
  showInFooter Boolean  @default(true)
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// Arka plan görevlerinin aynı anda tek yerde çalışmasını sağlayan kira kaydı.
model JobLock {
  name        String   @id
  holder      String
  lockedUntil DateTime
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Kurum paneli: etüt merkezi / dershane aboneliği
// Kurumun tüm kayıtları centerId ile ayrılır; her sorgu üyenin kurumuyla sınırlandırılır.
// ---------------------------------------------------------------------------

enum CenterKind {
  ETUT
  DERSHANE
  KURS
  OTHER
}

enum CenterStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum CenterPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum CenterRole {
  OWNER
  MANAGER
  TEACHER
  ACCOUNTANT
}

enum CenterStudentStatus {
  ACTIVE
  PASSIVE
  LEFT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EtudStatus {
  PLANNED
  DONE
  CANCELLED
}

enum ExamKind {
  LGS
  TYT
  AYT_SAY
  AYT_EA
  AYT_SOZ
  YDT
  CUSTOM
}

enum CenterNoteKind {
  GENERAL
  GUIDANCE
  PARENT_MEETING
  BEHAVIOR
}

enum CenterPaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITY
  SUPPLIES
  MARKETING
  TAX
  OTHER
}

enum MessageChannel {
  SMS
  EMAIL
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum HomeworkStatus {
  PENDING
  DONE
  PARTIAL
  MISSING
}

enum LeadStatus {
  NEW
  CONTACTED
  ENROLLED
  LOST
}

model Center {
  id                     String       @id @default(cuid())
  name                   String
  slug                   String       @unique
  kind                   CenterKind   @default(ETUT)
  status                 CenterStatus @default(TRIAL)
  plan                   CenterPlan   @default(STARTER)
  studentLimit           Int          @default(100)
  trialEndsAt            DateTime?
  paidUntil              DateTime?
  phone                  String?
  email                  String?
  address                String?
  cityId                 Int?
  city                   City?        @relation(fields: [cityId], references: [id])
  districtId             Int?
  district               District?    @relation(fields: [districtId], references: [id])
  taxOffice              String?
  taxNumber              String?
  logoKey                String?
  description            String?
  // Herkese açık vitrin sayfası (/kurumlar/slug) ve ön kayıt formu
  isPublic               Boolean      @default(false)
  academicYear           String       @default("2026-2027")
  notifyAbsence          Boolean      @default(true)
  remindPayments         Boolean      @default(true)
  reminderDaysBefore     Int          @default(3)
  // Veli portalında eksik konular için Pi Kampüs özel ders öğretmeni önerileri
  showTeacherSuggestions Boolean      @default(true)
  // Abonelik bitiş hatırlatması: en son gönderilen eşik (7, 3, 1, 0 gün); süre uzayınca sıfırlanır
  expiryNoticeDays       Int?
  nextReceiptNo          Int          @default(1)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  members              CenterMember[]
  subscriptionPayments CenterSubscriptionPayment[]
  students             CenterStudent[]
  groups               CenterGroup[]
  etuds                CenterEtud[]
  exams                CenterExam[]
  feePlans             CenterFeePlan[]
  payments             CenterPayment[]
  expenses             CenterExpense[]
  announcements        CenterAnnouncement[]
  messages             CenterMessage[]
  leads                CenterLead[]
  homeworks            CenterHomework[]

  @@index([status])
}

model CenterMember {
  id        String     @id @default(cuid())
  centerId  String
  center    Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CenterRole
  // Görev ve branş: "Müdür yardımcısı", "Matematik"
  title     String?
  branch    String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  groups    CenterGroup[]        @relation("GroupTeacher")
  slots     CenterScheduleSlot[] @relation("SlotTeacher")
  etuds     CenterEtud[]         @relation("EtudTeacher")
  homeworks CenterHomework[]     @relation("HomeworkTeacher")
  notes     CenterNote[]         @relation("NoteAuthor")
  expenses  CenterExpense[]      @relation("ExpenseMember")

  @@unique([centerId, userId])
  @@index([userId])
}

// Pi Kampüs'ün kuruma kestiği abonelik ödemeleri (yönetici kaydeder)
model CenterSubscriptionPayment {
  id          String   @id @default(cuid())
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  amount      Int
  months      Int
  periodStart DateTime
  periodEnd   DateTime
  method      String
  reference   String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([centerId])
}

model CenterStudent {
  id                String              @id @default(cuid())
  centerId          String
  center            Center              @relation(fields: [centerId], references: [id], onDelete: Cascade)
  studentNumber     String?
  firstName         String
  lastName          String
  gender            Gender              @default(UNSPECIFIED)
  birthDate         DateTime?           @db.Date
  identityNumberEnc String?
  schoolName        String?
  gradeName         String?
  targetExam        String?
  phone             String?
  email             String?
  address           String?
  notes             String?
  status            CenterStudentStatus @default(ACTIVE)
  enrolledAt        DateTime            @default(now())
  leftAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  guardians    CenterGuardian[]
  groups       CenterGroupStudent[]
  attendance   CenterAttendance[]
  etuds        CenterEtudStudent[]
  examResults  CenterExamResult[]
  noteEntries  CenterNote[]
  feePlans     CenterFeePlan[]
  installments CenterInstallment[]
  payments     CenterPayment[]
  homeworks    CenterHomeworkStudent[]

  @@unique([centerId, studentNumber])
  @@index([centerId, status])
}

model CenterGuardian {
  id              String        @id @default(cuid())
  centerId        String
  studentId       String
  student         CenterStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fullName        String
  relation        String
  phone           String?
  email           String?
  isPrimary       Boolean       @default(false)
  notifySms       Boolean       @default(true)
  notifyEmail     Boolean       @default(true)
  // Veli portalı: davetle sitedeki veli hesabına bağlanır
  userId          String?
  user            User?         @relation("GuardianAccounts", fields: [userId], references: [id], onDelete: SetNull)
  inviteTokenHash String?       @unique
  inviteExpiresAt DateTime?
  linkedAt        DateTime?
  createdAt       DateTime      @default(now())

  @@index([centerId])
  @@index([studentId])
  @@index([userId])
}

model CenterGroup {
  id         String        @id @default(cuid())
  centerId   String
  center     Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name       String
  gradeName  String?
  targetExam String?
  teacherId  String?
  teacher    CenterMember? @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  room       String?
  capacity   Int?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())

  students      CenterGroupStudent[]
  slots         CenterScheduleSlot[]
  sessions      CenterAttendanceSession[]
  announcements CenterAnnouncement[]
  homeworks     CenterHomework[]

  @@unique([centerId, name])
}

model CenterGroupStudent {
  groupId   String
  group     CenterGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   CenterStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime      @default(now())

  @@id([groupId, studentId])
  @@index([studentId])
}

// Haftalık ders programı
model CenterScheduleSlot {
  id          String        @id @default(cuid())
  centerId    String
  groupId     String
  group       CenterGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  weekday     Int
  startMinute Int
  endMinute   Int
  subject     String
  teacherId   String?
  teacher     CenterMember? @relation("SlotTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  room        String?

  @@index([centerId, weekday])
  @@index([groupId])
}

// Bir grubun belirli bir gündeki dersi için alınan yoklama
model CenterAttendanceSession {
  id          String      @id @default(cuid())
  centerId    String
  groupId     String
  group       CenterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slotId      String?
  date        DateTime    @db.Date
  startMinute Int
  endMinute   Int
  subject     String
  teacherId   String?
  takenById   String?
  takenAt     DateTime?
  createdAt   DateTime    @default(now())

  records CenterAttendance[]

  @@unique([groupId, date, startMinute])
  @@index([centerId, date])
}

model CenterAttendance {
  id         String                  @id @default(cuid())
  sessionId  String
  session    CenterAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    CenterStudent           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     AttendanceStatus
  note       String?
  notifiedAt DateTime?

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// Birebir veya küçük grup etüt
model CenterEtud {
  id          String        @id @default(cuid())
  centerId    String
  center      Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacherId   String?
  teacher     CenterMember? @relation("EtudTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  date        DateTime      @db.Date
  startMinute Int
  endMinute   Int
  subject     String
  topic       String?
  room        String?
  status      EtudStatus    @default(PLANNED)
  notes       String?
  createdAt   DateTime      @default(now())

  students CenterEtudStudent[]

  @@index([centerId, date])
}

model CenterEtudStudent {
  etudId     String
  etud       CenterEtud        @relation(fields: [etudId], references: [id], onDelete: Cascade)
  studentId  String
  student    CenterStudent     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendance AttendanceStatus?

  @@id([etudId, studentId])
  @@index([studentId])
}

model CenterExam {
  id           String   @id @default(cuid())
  centerId     String
  center       Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name         String
  kind         ExamKind
  date         DateTime @db.Date
  publisher    String?
  // Yanlış başına götürülen doğru: LGS 1/3, YKS 1/4, 0 = götürmez
  wrongPenalty Float
  // Veliler sonucu portalda görebilir
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())

  sections CenterExamSection[]
  results  CenterExamResult[]

  @@index([centerId, date])
}

model CenterExamSection {
  id            String     @id @default(cuid())
  examId        String
  exam          CenterExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  name          String
  questionCount Int
  order         Int
  // Pazaryerindeki ders (eksik konuya özel ders önerisi için)
  subjectSlug   String?
  // Cevap anahtarı: A-E, iptal edilen soru X
  answerKey     String?
  // Soru başına konu / kazanım
  topics        String[]

  results CenterExamSectionResult[]
}

model CenterExamResult {
  id        String        @id @default(cuid())
  examId    String
  exam      CenterExam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   CenterStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  correct   Int
  wrong     Int
  blank     Int
  net       Float
  // Yayınevinin bildirdiği puan (varsa)
  score     Float?
  rank      Int?
  createdAt DateTime      @default(now())

  sections CenterExamSectionResult[]

  @@unique([examId, studentId])
  @@index([studentId])
}

model CenterExamSectionResult {
  id        String            @id @default(cuid())
  resultId  String
  result    CenterExamResult  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  sectionId String
  section   CenterExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  correct   Int
  wrong     Int
  blank     Int
  net       Float
  answers   String?

  @@unique([resultId, sectionId])
  @@index([sectionId])
}

// Rehberlik, veli görüşmesi ve genel notlar
model CenterNote {
  id              String         @id @default(cuid())
  centerId        String
  studentId       String
  student         CenterStudent  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId        String?
  author          CenterMember?  @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  kind            CenterNoteKind @default(GENERAL)
  text            String
  visibleToParent Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([studentId])
}

// Öğrenci ödeme planı (sözleşme) ve taksitleri
model CenterFeePlan {
  id             String        @id @default(cuid())
  centerId       String
  center         Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  studentId      String
  student        CenterStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title          String
  totalAmount    Int
  discountAmount Int           @default(0)
  netAmount      Int
  note           String?
  isCancelled    Boolean       @default(false)
  createdAt      DateTime      @default(now())

  installments CenterInstallment[]

  @@index([centerId])
  @@index([studentId])
}

model CenterInstallment {
  id         String        @id @default(cuid())
  planId     String
  plan       CenterFeePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  centerId   String
  studentId  String
  student    CenterStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order      Int
  dueDate    DateTime      @db.Date
  amount     Int
  paidAmount Int           @default(0)
  remindedAt DateTime?

  allocations CenterPaymentAllocation[]

  @@index([centerId, dueDate])
  @@index([studentId])
}

// Tahsilat (makbuz numarası kurum içinde sıralıdır)
model CenterPayment {
  id           String              @id @default(cuid())
  centerId     String
  center       Center              @relation(fields: [centerId], references: [id], onDelete: Cascade)
  studentId    String
  student      CenterStudent       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receiptNo    Int
  amount       Int
  method       CenterPaymentMethod
  paidAt       DateTime
  payerName    String?
  note         String?
  createdById  String?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime            @default(now())

  allocations CenterPaymentAllocation[]

  @@unique([centerId, receiptNo])
  @@index([centerId, paidAt])
  @@index([studentId])
}

model CenterPaymentAllocation {
  paymentId     String
  payment       CenterPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installmentId String
  installment   CenterInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amount        Int

  @@id([paymentId, installmentId])
}

model CenterExpense {
  id          String          @id @default(cuid())
  centerId    String
  center      Center          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Int
  date        DateTime        @db.Date
  description String?
  paidTo      String?
  // Personel ödemesi
  memberId    String?
  member      CenterMember?   @relation("ExpenseMember", fields: [memberId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([centerId, date])
}

model CenterAnnouncement {
  id          String       @id @default(cuid())
  centerId    String
  center      Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  title       String
  body        String
  // Boşsa tüm kurum
  groupId     String?
  group       CenterGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sendEmail   Boolean      @default(false)
  sendSms     Boolean      @default(false)
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([centerId, createdAt])
}

// Velilere giden SMS ve e-postaların kaydı (SMS gönderim kuyruğu)
model CenterMessage {
  id         String         @id @default(cuid())
  centerId   String
  center     Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  channel    MessageChannel
  to         String
  subject    String?
  body       String
  kind       String
  studentId  String?
  status     MessageStatus  @default(QUEUED)
  error      String?
  providerId String?
  createdAt  DateTime       @default(now())
  sentAt     DateTime?

  @@index([centerId, createdAt])
  @@index([status, createdAt])
}

// Ön kayıt / aday öğrenci
model CenterLead {
  id          String     @id @default(cuid())
  centerId    String
  center      Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  studentName String
  parentName  String?
  phone       String
  email       String?
  gradeName   String?
  message     String?
  source      String     @default("web")
  status      LeadStatus @default(NEW)
  note        String?
  createdAt   DateTime   @default(now())

  @@index([centerId, status])
}

// "Kurumlar için" sayfasındaki demo / abonelik başvurusu
model CenterApplication {
  id           String            @id @default(cuid())
  centerName   String
  kind         CenterKind        @default(ETUT)
  contactName  String
  phone        String
  email        String
  cityId       Int?
  city         City?             @relation(fields: [cityId], references: [id])
  studentCount String?
  message      String?
  status       ApplicationStatus @default(NEW)
  centerId     String?
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([status, createdAt])
}

// Ödev: sınıfa (ya da seçilen öğrencilere) verilir, teslimde öğrenci bazında kontrol edilir
model CenterHomework {
  id          String        @id @default(cuid())
  centerId    String
  center      Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groupId     String?
  group       CenterGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  teacherId   String?
  teacher     CenterMember? @relation("HomeworkTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  subject     String
  title       String
  description String?
  assignedOn  DateTime      @db.Date
  dueDate     DateTime      @db.Date
  checkedAt   DateTime?
  createdAt   DateTime      @default(now())

  students CenterHomeworkStudent[]

  @@index([centerId, dueDate])
}

model CenterHomeworkStudent {
  homeworkId String
  homework   CenterHomework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    CenterStudent  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     HomeworkStatus @default(PENDING)
  note       String?
  notifiedAt DateTime?

  @@id([homeworkId, studentId])
  @@index([studentId])
}
