    "@prisma/client": "7.10.0",
    "date-fns": "^4.4.0",
    "iyzipay": "^2.0.70",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
